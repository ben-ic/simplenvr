{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SimpleNVR",
  "version": "0.1.0",
  "identifier": "com.simplenvr.app",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "cd ../frontend && npm run dev",
    "beforeBuildCommand": "cd ../frontend && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "SimpleNVR",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/tether",
      "binaries/ffmpeg",
      "binaries/ffprobe",
      "binaries/go2rtc"
    ],
    "resources": [
      "binaries/simplenvr-backend-dir"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
