{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for SimpleNVR",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "shell:default",
    "dialog:default",
    "rtsp-mosaic:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/tether",
          "sidecar": true,
          "args": false
        },
        {
          "name": "binaries/simplenvr-backend",
          "sidecar": true,
          "args": false
        },
        {
          "name": "binaries/go2rtc",
          "sidecar": true,
          "args": false
        }
      ]
    }
  ]
}
